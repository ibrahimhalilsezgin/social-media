# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=social_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/social_db?schema=public"

# Cassandra
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_LOCAL_DATA_CENTER=datacenter1
CASSANDRA_KEYSPACE=social

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200

# MinIO (S3)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_REGION=us-east-1

# Auth
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
